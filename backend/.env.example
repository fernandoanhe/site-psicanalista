# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-key

# JWT
JWT_SECRET=gere-uma-string-aleatoria-longa-aqui

# Admin
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=sua-senha-segura

# E-mail via Gmail (SMTP). SMTP_PASS = senha de app do Google, 16 letras sem espaços
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM="Seu Nome" <seu@gmail.com>
EMAIL_ADMIN=seu@email.com

# PagSeguro
PAGSEGURO_TOKEN=seu-token-pagseguro
PAGSEGURO_ENV=sandbox

# URLs
SITE_URL=https://site-psicanalista-three.vercel.app
BACKEND_URL=https://backend-psicanalista.vercel.app

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-sua-chave
MERCADOPAGO_ENV=sandbox

# Painel admin (para CORS)
ADMIN_URL=https://seu-admin.vercel.app
# Origens extras separadas por vírgula (ex.: domínio próprio com e sem www)
CORS_ORIGINS=

# Lembretes: GET /api/cron/reminders com "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=gere-uma-string-aleatoria-longa-aqui

# Google Agenda + Meet (opcional). OAuth client "Desktop app" do Google Cloud.
# GOOGLE_REFRESH_TOKEN é gerado por: node scripts/google-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
